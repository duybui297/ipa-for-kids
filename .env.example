# Supabase (Project Settings → API). Đây là key public (anon / publishable), an toàn để đưa vào frontend
# vì dữ liệu đã được bảo vệ bằng Row Level Security. KHÔNG dùng service_role key ở đây.
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Đường dẫn app được phục vụ (mặc định /products/ipa-for-kids/). Đặt "/" khi chạy ở domain riêng.
# BASE_PATH="/products/ipa-for-kids/"
